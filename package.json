{
  "name": "vendurepos-web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "links:check": "linkinator --recurse --check-fragments --skip '^(?!http://localhost:3000)'",
    "lint": "eslint --max-warnings=0",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "test": "node --test tests/structured-data.test.mjs tests/features.test.mjs tests/site-config.test.mjs tests/docs-pages.test.mjs tests/plugin-version.test.mjs tests/llms-txt.test.mjs tests/analytics-interaction.test.mjs tests/sitemap.test.mjs tests/sitemap-seeds.test.mjs",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "14.2.8",
    "fumadocs-ui": "16.16.2",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "posthog-js": "1.436.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "takumi-js": "^2.14.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "linkinator": "8.1.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "browserslist": ["chrome >= 111", "edge >= 111", "firefox >= 128", "safari >= 16.4"],
  "packageManager": "pnpm@10.28.2"
}
